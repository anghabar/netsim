{
  // Type check for the test tree and the tool configuration files.
  // Run with: npm run typecheck:tests
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Vitest globals are disabled: test APIs are imported from 'vitest',
    // so no 'vitest/globals' entry is needed here.
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/tests",
    "src/**/*.d.ts",
    // Feature slices extend the store state type from their own file and are
    // discovered at run time, not through imports. Listing them here makes
    // that state visible to every test, whether or not it imports the slice.
    "src/features/*/feature.slice.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    // Suites written for the Node.js built-in test runner and their
    // aggregator. Same list as LEGACY_NODE_RUNNER_SUITES in vitest.config.ts.
    "src/tests/index.ts",
    "src/tests/PingCommand.test.ts",
    "src/tests/cliAcl.test.ts",
    "src/tests/cliCisco.test.ts",
    "src/tests/cliExport.test.ts",
    "src/tests/cliFlows.test.ts",
    "src/tests/cliHelpers.test.ts",
    "src/tests/cliProfiles.test.ts",
    "src/tests/cliStp.test.ts",
    "src/tests/logic.test.ts",
    "src/tests/schemaMigrations.test.ts",
    "src/tests/topology-logic.test.ts",
    "src/tests/topology.test.ts",
    "src/tests/integration/CliTopologyIntegration.test.ts",
    // These suites run under Vitest, but their shared helper builds a device
    // without a required field. Remove this entry once the helper is fixed.
    "src/tests/commands/**"
  ]
}
